# Copy this file to .env and fill in your values.
# This project compares MCX (India) vs COMEX (US) gold prices.

MCX_PRICE_API_URL="https://example.com/api/mcx-gold-price"
COMEX_PRICE_API_URL="https://query1.finance.yahoo.com/v8/finance/chart/GC=F"
COMEX_SYMBOL="GC=F"
MCX_SYMBOL=""

ALERT_PERCENT_DROP=5.0
HISTORY_WINDOW=12
ALERT_INTERVAL_MINUTES=30

TWILIO_ACCOUNT_SID="your_account_sid"
TWILIO_AUTH_TOKEN="your_auth_token"
WHATSAPP_FROM="whatsapp:+14155238886"
WHATSAPP_TO="whatsapp:+919876543210"

DB_PATH="market_history.db"

# Optional: customise the alert timestamp formatting
TIMEZONE="Asia/Kolkata"
