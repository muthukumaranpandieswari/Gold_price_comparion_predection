# Copy this file to .env and fill in your values.
# MCX data availability varies by provider; set its URL or Yahoo Finance symbol.
MCX_PRICE_API_URL="https://your-provider.example.com/api/mcx-gold-price"
COMEX_PRICE_API_URL="https://query1.finance.yahoo.com/v8/finance/chart/GC=F"
COMEX_SYMBOL="GC=F"
MCX_SYMBOL=""

# Alert when a new price is this percentage below its previous rolling average.
ALERT_PERCENT_DROP=5.0
HISTORY_WINDOW=12
ALERT_INTERVAL_MINUTES=30

# SMTP email notification settings (use an app password where your provider requires one).
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER="alerts@example.com"
SMTP_PASSWORD="your_email_app_password"
EMAIL_FROM="alerts@example.com"
EMAIL_TO="hapieeji@gmail.com"

DB_PATH="market_history.db"
TIMEZONE="Asia/Kolkata"

# Optional note appended to alert emails. Keep time-sensitive market data up to date.
MARKET_CONTEXT=""
